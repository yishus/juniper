{
  "name": "juniper",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --live-reload",
    "build": "NODE_ENV=production node --import remix/node-tsx scripts/build.ts",
    "preview": "npm run dev",
    "db:migrate:local": "wrangler d1 migrations apply juniper-articles --local",
    "db:migrate:remote": "wrangler d1 migrations apply juniper-articles --remote",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run --outdir dist/dry-run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-auth": "^1.7.12",
    "domhandler": "^5.0.3",
    "domutils": "^3.2.2",
    "drizzle-orm": "^0.45.4",
    "htmlparser2": "^10.0.0",
    "marked": "^16.4.2",
    "remix": "^3.0.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@tailwindcss/oxide": "^4.1.18",
    "@types/node": "latest",
    "esbuild": "^0.27.7",
    "lightningcss": "^1.33.0",
    "tailwindcss": "^4.1.18",
    "typescript": "latest",
    "wrangler": "^4.131.1"
  }
}
